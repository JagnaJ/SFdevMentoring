    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object is used to track and plan vehicle sales. It includes the forecasted number of cars to be sold, projected revenue, and actual sales performance.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Planned Sales</label>
    <nameField>
        <label>Planned Sales Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Planned Sales</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Car_Type__c</fullName>
        <description>Indicates whether the planned sales are for new or used cars.</description>
        <inlineHelpText>Select the type of car for the planned sales.</inlineHelpText>
        <label>Car Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Conditions</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Count_of_Cars_Sold__c</fullName>
        <description>This field will be populated automatically based on sales records.</description>
        <externalId>false</externalId>
        <inlineHelpText>This field reflects the count of cars sold.</inlineHelpText>
        <label>Count of Cars Sold</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Month__c</fullName>
        <description>Represents the month for the planned sales.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the month for which you are planning the sales.</inlineHelpText>
        <label>Month</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Planned_Count__c</fullName>
        <description>Number of cars planned to be sold.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the number of cars you plan to sell for this period.</inlineHelpText>
        <label>Planned Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Planned_Total_Amount__c</fullName>
        <description>Expected revenue from these planned sales.</description>
        <inlineHelpText>Enter the expected total revenue from planned sales.</inlineHelpText>
        <label>Planned Total Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Total_Amount_Earned__c</fullName>
        <description>This field will be populated automatically based on sales records.</description>
        <inlineHelpText>This field reflects the total amount earned from sales.</inlineHelpText>
        <label>Total Amount Earned</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Year__c</fullName>
        <description>Represents the year for the planned sales.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the year for which you are planning the sales.</inlineHelpText>
        <label>Year</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
</CustomObject>
