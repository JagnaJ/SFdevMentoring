    <recordTypes>
        <fullName>For_Sale</fullName>
        <active>true</active>
        <description>Cars available for sale.</description>
        <label>For Sale</label>
        <picklistValues>
            <picklist>Car_Status__c</picklist>
            <values>
                <fullName>Available</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>On Hold</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Reserved</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Sold</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Condition__c</picklist>
            <values>
                <fullName>New</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Used</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Drive_Type__c</picklist>
            <values>
                <fullName>4WD %28Four-Wheel Drive%29</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>AWD %28All-Wheel Drive%29</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>FWD %28Front-Wheel Drive%29</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>RWD %28Rear-Wheel Drive%29</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Family</picklist>
            <values>
                <fullName>None</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Fuel_Type__c</picklist>
            <values>
                <fullName>Diesel</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Electric</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Gasoline</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Hybrid</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>QuantityUnitOfMeasure</picklist>
            <values>
                <fullName>Each</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Safety_Rating__c</picklist>
            <values>
