    <fields>
        <fullName>Brand__c</fullName>
        <description>The brand of the car.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the manufacturer or brand of the car.</inlineHelpText>
        <label>Brand</label>
        <length>20</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Buyer_Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Select the contact who purchased the car.</description>
        <inlineHelpText>This field allows you to link the buyer of the car to their contact record for better tracking and communication.</inlineHelpText>
        <label>Buyer Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Cars</relationshipLabel>
        <relationshipName>PurchasedCars</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Car_Status__c</fullName>
        <label>Car Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>On Hold</fullName>
                    <default>false</default>
                    <label>On Hold</label>
                </value>
                <value>
                    <fullName>Available</fullName>
                    <default>false</default>
                    <label>Available</label>
                </value>
                <value>
                    <fullName>Reserved</fullName>
                    <default>false</default>
                    <label>Reserved</label>
                </value>
                <value>
                    <fullName>Sold</fullName>
                    <default>false</default>
                    <label>Sold</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Condition__c</fullName>
        <description>The condition of the car.</description>
        <inlineHelpText>Select whether the car is new or used.</inlineHelpText>
        <label>Condition</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Conditions</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Customer__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Links to the Account that purchased the car.</description>
        <inlineHelpText>Select the customer who bought this car.</inlineHelpText>
        <label>Customer</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Cars</relationshipLabel>
        <relationshipName>AccountCars</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Delivery_Date__c</fullName>
        <description>The date on which the car is delivered to the customer.</description>
        <inlineHelpText>Please enter the delivery date in the format MM/DD/YYYY.</inlineHelpText>
        <label>Delivery Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Description</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Discount_Made_Percent__c</fullName>
        <description>Calculates the percentage difference between the Sale Price and the Final Sale Price.</description>
        <formula>((Sale_Price__c - Final_Sale_Price__c) / Sale_Price__c) * 100</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This field automatically calculates the discount percentage applied to the sale.</inlineHelpText>
        <label>Discount Made Percent</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Discount_Made__c</fullName>
        <description>Calculates the difference between the Sale Price and the Final Sale Price.</description>
        <formula>Sale_Price__c - Final_Sale_Price__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This field automatically calculates the discount amount applied to the sale.</inlineHelpText>
        <label>Discount Made</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>DisplayUrl</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
