    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object manages payments for car orders, contracts, and other financial transactions related to the sale of vehicles.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Order Payment</label>
    <nameField>
        <label>Order Payment Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Order Payments</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <startsWith>Vowel</startsWith>
    <visibility>Public</visibility>
    <fields>
        <fullName>Amount__c</fullName>
        <description>The amount paid in the transaction.</description>
        <inlineHelpText>This field records the amount paid for the car purchase in this specific transaction.</inlineHelpText>
        <label>Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Comments__c</fullName>
        <description>Any additional notes or comments related to the payment.</description>
        <externalId>false</externalId>
        <inlineHelpText>This field allows for additional notes or comments regarding the payment for the car.</inlineHelpText>
        <label>Comments</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Contract__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The field links the order to the related contract.</description>
        <inlineHelpText>This field connects the payment to the corresponding contract associated with the car purchase.</inlineHelpText>
        <label>Contract</label>
        <referenceTo>Contract</referenceTo>
        <relationshipLabel>Order Payments</relationshipLabel>
        <relationshipName>Order_Payments</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Date__c</fullName>
        <description>The date the payment was made.</description>
        <inlineHelpText>This field indicates the date on which the payment was made for the car.</inlineHelpText>
        <label>Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
</CustomObject>
